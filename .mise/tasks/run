#!/usr/bin/env bash
#MISE description="Run one bounded drone session and write logs/result JSON"
#USAGE flag "--profile <profile>" default="plain" help="Launch profile (default: plain)"
#USAGE flag "--model <model>" default="" help="Provider-qualified model; may also use SPHINCTERS_MODEL or SESSIONS_DEFAULT_MODEL"
#USAGE flag "--prompt <text>" default="" help="Prompt text (required unless --prompt-file is given)"
#USAGE flag "--prompt-file <file>" default="" help="Prompt file (overrides --prompt)"
#USAGE flag "--cwd <dir>" default="" help="Working directory requested from the profile"
#USAGE flag "--out-dir <dir>" default="" help="Directory for logs/results (default: /tmp/sphincters-run-*)"
#USAGE flag "--name <name>" default="" help="Session name (default: generated unique name)"
#USAGE flag "--result-file <file>" default="" help="Where to write result JSON (default: <out-dir>/<session>.result.json)"
#USAGE flag "--json" default=#false help="Print result JSON to stdout"
#USAGE flag "--background" default=#false help="Return after wake with attach/result handles instead of blocking on sessions read"
#USAGE flag "--dry-run" default=#false help="Prepare files/result without launching sessions"
#USAGE example "mise run run --dry-run --model fake/model --prompt 'Say hello' --json" header="Prepare a run without launching a model"
#USAGE example "mise run run --profile plain --model openai-codex/gpt-5.5 --prompt-file task.md" header="Run the default plain profile"
#USAGE example "mise run run --profile sibling --background --model openai-codex/gpt-5.5 --prompt-file task.md --json" header="Launch a non-blocking sibling worker and print attach handles"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/drones.sh"

profile="$usage_profile"
model=$(drones_resolve_model "$usage_model")
caller_pwd=$(drones_caller_pwd)
stamp=$(date -u '+%Y%m%dT%H%M%SZ')
safe_profile=$(printf '%s' "$profile" | drones_safe_name)
base="sphincters-run-${safe_profile}-${stamp}-$$"
out_dir_arg="${usage_out_dir:-/tmp/$base}"
out_dir=$(drones_resolve_path "$out_dir_arg")
name="${usage_name:-$base}"
if ! drones_validate_session_name "$name"; then
  exit 2
fi

if [ -n "$usage_result_file" ]; then
  result_file=$(drones_resolve_path "$usage_result_file")
else
  result_file="$out_dir/$name.result.json"
fi

requested_cwd=""
if [ -n "$usage_cwd" ]; then
  requested_cwd=$(drones_resolve_path "$usage_cwd")
fi

mkdir -p "$out_dir"
drones_mkdir_parent "$result_file"

prompt_file="$out_dir/$name.prompt.md"
if [ -n "$usage_prompt_file" ]; then
  source_prompt_file=$(drones_resolve_path "$usage_prompt_file")
  if [ ! -f "$source_prompt_file" ]; then
    echo "error: prompt file not found: $source_prompt_file" >&2
    exit 2
  fi
  cp "$source_prompt_file" "$prompt_file"
elif [ -n "$usage_prompt" ]; then
  printf '%s\n' "$usage_prompt" > "$prompt_file"
else
  echo "error: must provide --prompt or --prompt-file" >&2
  exit 2
fi

DRONES_PROFILE_EXEC=""
DRONES_PROFILE_SUFFIX=""
drones_profile_executable "$profile"
profile_spec_file="$out_dir/$name.profile.json"
if (
  export SPHINCTERS_PROFILE="$profile"
  export SPHINCTERS_PROFILE_SUFFIX="$DRONES_PROFILE_SUFFIX"
  export SPHINCTERS_OUT_DIR="$out_dir"
  export SPHINCTERS_CWD="$requested_cwd"
  export SPHINCTERS_MODEL="$model"
  export SPHINCTERS_CALLER_PWD="$caller_pwd"
  # Backward-compatible aliases for older local profile experiments.
  export DRONES_PROFILE="$SPHINCTERS_PROFILE"
  export DRONES_PROFILE_SUFFIX="$SPHINCTERS_PROFILE_SUFFIX"
  export DRONES_OUT_DIR="$SPHINCTERS_OUT_DIR"
  export DRONES_CWD="$SPHINCTERS_CWD"
  export DRONES_MODEL="$SPHINCTERS_MODEL"
  export DRONES_CALLER_PWD="$SPHINCTERS_CALLER_PWD"
  "$DRONES_PROFILE_EXEC"
) > "$profile_spec_file"; then
  :
else
  profile_rc=$?
  echo "error: profile failed (rc=$profile_rc): $profile" >&2
  exit "$profile_rc"
fi

if ! jq -e '
  .version == 1
  and (.profile.name | type == "string")
  and (.profile.kind | type == "string")
  and (.profile.subject | type == "string")
  and (.cwd | type == "string")
  and ((.unset_env // []) | type == "array")
  and ((.meta // {}) | type == "object")
' "$profile_spec_file" >/dev/null; then
  echo "error: profile emitted invalid launch spec: $profile_spec_file" >&2
  exit 2
fi

profile_kind=$(jq -r '.profile.kind' "$profile_spec_file")
profile_subject=$(jq -r '.profile.subject' "$profile_spec_file")
cwd=$(jq -r '.cwd' "$profile_spec_file")
system_prompt_file=$(jq -r '.system_prompt_file // empty' "$profile_spec_file")
if [ -z "$cwd" ]; then
  echo "error: profile emitted empty cwd: $profile_spec_file" >&2
  exit 2
fi
if [ -n "$system_prompt_file" ] && [ ! -f "$system_prompt_file" ]; then
  echo "error: profile system prompt file not found: $system_prompt_file" >&2
  exit 2
fi

new_log="$out_dir/$name.new.log"
wake_log="$out_dir/$name.wake.log"
read_log="$out_dir/$name.read.log"
transcript_file="$out_dir/$name.transcript.txt"
started_at=$(drones_now_iso)

profile_rc=0
new_rc=-1
wake_rc=-1
read_rc=-1
read_skipped=false
shell_attach_command="shell attach $name"
shell_status_command="shell status $name"
shell_wait_command="shell wait $name"
sessions_read_command="sessions read $name"

if [ "$usage_dry_run" = "true" ]; then
  new_rc=0
  wake_rc=0
  read_rc=0
  printf 'dry run: sessions new skipped\n' > "$new_log"
  printf 'dry run: sessions wake skipped\n' > "$wake_log"
  if [ "$usage_background" = "true" ]; then
    read_skipped=true
    printf 'dry run: sessions read skipped for background run\n' > "$read_log"
  else
    printf 'dry run: sessions read skipped\n' > "$read_log"
  fi
  printf 'dry run transcript placeholder\n' > "$transcript_file"
else
  new_cmd=(
    sessions new "$name"
    --cwd "$cwd"
    --meta "drone.tool=sphincters"
    --meta "drone.profile=$profile"
    --meta "drone.kind=$profile_kind"
    --meta "drone.subject=$profile_subject"
    --meta "drone.out_dir=$out_dir"
    --meta "drone.caller_pwd=$caller_pwd"
  )
  while IFS=$'\t' read -r key value; do
    [ -n "$key" ] || continue
    new_cmd+=(--meta "$key=$value")
  done < <(jq -r '.meta // {} | to_entries[] | [.key, (.value | tostring)] | @tsv' "$profile_spec_file")

  if "${new_cmd[@]}" >"$new_log" 2>&1; then
    new_rc=0
  else
    new_rc=$?
  fi

  if [ "$new_rc" -eq 0 ]; then
    wake_cmd=(
      sessions wake "$name"
      --headless
      --model "$model"
      --context-file "$prompt_file"
      --message "Read the sphincters prompt context and complete the task."
      --meta "wake.purpose=sphincters-run"
      --meta "drone.profile=$profile"
      --meta "drone.kind=$profile_kind"
    )
    if [ "$usage_background" = "true" ]; then
      wake_cmd+=(--background)
    fi

    env_cmd=(env)
    while IFS= read -r env_name; do
      [ -n "$env_name" ] || continue
      if ! drones_validate_env_name "$env_name"; then
        echo "error: profile requested invalid env unset: $env_name" >&2
        exit 2
      fi
      env_cmd+=(-u "$env_name")
    done < <(jq -r '.unset_env[]?' "$profile_spec_file")

    if [ -n "$system_prompt_file" ]; then
      system_prompt=$(cat "$system_prompt_file")
      env_cmd+=("AGENT_IDENTITY=$system_prompt")
    else
      system_prompt=""
    fi

    if "${env_cmd[@]}" "${wake_cmd[@]}" >"$wake_log" 2>&1; then
      wake_rc=0
    else
      wake_rc=$?
    fi
    unset system_prompt
  fi

  if [ "$new_rc" -eq 0 ]; then
    if [ "$usage_background" = "true" ]; then
      read_rc=0
      read_skipped=true
      {
        printf 'background run: sessions read skipped\n'
        printf 'attach: %s\n' "$shell_attach_command"
        printf 'read later: %s\n' "$sessions_read_command"
      } >"$read_log"
      printf 'background run transcript not collected; use %s after completion\n' "$sessions_read_command" >"$transcript_file"
    elif sessions read "$name" >"$transcript_file" 2>"$read_log"; then
      read_rc=0
    else
      read_rc=$?
    fi
  fi
fi

finished_at=$(drones_now_iso)
result_tmp="$result_file.tmp.$$"
trap 'rm -f "$result_tmp"' EXIT

jq -n \
  --slurpfile spec "$profile_spec_file" \
  --arg type "sphincters-run" \
  --arg session "$name" \
  --arg model "$model" \
  --arg caller_pwd "$caller_pwd" \
  --arg out_dir "$out_dir" \
  --arg cwd "$cwd" \
  --arg prompt_file "$prompt_file" \
  --arg profile_spec_file "$profile_spec_file" \
  --arg system_prompt_file "$system_prompt_file" \
  --arg result_file "$result_file" \
  --arg transcript_file "$transcript_file" \
  --arg shell_attach_command "$shell_attach_command" \
  --arg shell_status_command "$shell_status_command" \
  --arg shell_wait_command "$shell_wait_command" \
  --arg sessions_read_command "$sessions_read_command" \
  --arg new_log "$new_log" \
  --arg wake_log "$wake_log" \
  --arg read_log "$read_log" \
  --arg started_at "$started_at" \
  --arg finished_at "$finished_at" \
  --argjson dry_run "$usage_dry_run" \
  --argjson background "$usage_background" \
  --argjson read_skipped "$read_skipped" \
  --argjson profile_rc "$profile_rc" \
  --argjson new_rc "$new_rc" \
  --argjson wake_rc "$wake_rc" \
  --argjson read_rc "$read_rc" \
  '{
    type: $type,
    session: $session,
    profile: $spec[0].profile,
    model: $model,
    dry_run: $dry_run,
    background: $background,
    caller_pwd: $caller_pwd,
    cwd: $cwd,
    out_dir: $out_dir,
    profile_spec_file: $profile_spec_file,
    profile_spec: $spec[0],
    files: {
      prompt: $prompt_file,
      system_prompt: $system_prompt_file,
      result: $result_file,
      transcript: $transcript_file,
      logs: {new: $new_log, wake: $wake_log, read: $read_log}
    },
    handles: {
      attach: $shell_attach_command,
      status: $shell_status_command,
      wait: $shell_wait_command,
      read: $sessions_read_command
    },
    read: {skipped: $read_skipped},
    started_at: $started_at,
    finished_at: $finished_at,
    rc: {profile: $profile_rc, new: $new_rc, wake: $wake_rc, read: $read_rc}
  }' \
  > "$result_tmp"
mv "$result_tmp" "$result_file"

final_rc=0
if [ "$profile_rc" -ne 0 ]; then
  final_rc="$profile_rc"
elif [ "$new_rc" -ne 0 ]; then
  final_rc="$new_rc"
elif [ "$wake_rc" -ne 0 ]; then
  final_rc="$wake_rc"
elif [ "$read_rc" -ne 0 ]; then
  final_rc="$read_rc"
fi

if [ "$usage_json" = "true" ]; then
  cat "$result_file"
else
  printf '%s\n' '== sphincters:run =='
  printf '  session:    %s\n' "$name"
  printf '  profile:    %s (%s)\n' "$profile" "$profile_kind"
  printf '  subject:    %s\n' "$profile_subject"
  printf '  model:      %s\n' "$model"
  printf '  dry run:    %s\n' "$usage_dry_run"
  printf '  background: %s\n' "$usage_background"
  printf '  out:        %s\n' "$out_dir"
  printf '  result:     %s\n' "$result_file"
  if [ "$usage_background" = "true" ]; then
    printf '  attach:     %s\n' "$shell_attach_command"
    printf '  read later: %s\n' "$sessions_read_command"
  fi
  printf '  transcript: %s\n' "$transcript_file"
  printf '  rc:         profile=%s new=%s wake=%s read=%s\n' "$profile_rc" "$new_rc" "$wake_rc" "$read_rc"
fi

if [ "$final_rc" -ne 0 ]; then
  echo "error: sphincters run failed (rc=$final_rc); logs are in $out_dir" >&2
  if [ -s "$wake_log" ]; then
    echo "--- wake log tail ---" >&2
    tail -40 "$wake_log" >&2
  elif [ -s "$new_log" ]; then
    echo "--- new log tail ---" >&2
    tail -40 "$new_log" >&2
  elif [ -s "$read_log" ]; then
    echo "--- read log tail ---" >&2
    tail -40 "$read_log" >&2
  fi
fi

exit "$final_rc"
